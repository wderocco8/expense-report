{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --target=node24 --external:sharp --outdir=dist",
    "deploy:local": "./scripts/deploy-local.sh",
    "deploy:staging": "npm run build && cdk deploy WorkerStack-staging --require-approval never",
    "deploy:prod": "npm run build && cdk deploy WorkerStack-prod --require-approval never",
    "send:test": "tsx scripts/send-test-message.ts",
    "dev": "tsx dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/client-sqs": "^3.975.0",
    "@aws-sdk/client-textract": "^3.953.0",
    "@aws-sdk/s3-request-presigner": "^3.956.0",
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "aws-cdk-lib": "^2.236.0",
    "constructs": "^10.4.5",
    "dotenv": "^17.2.3",
    "path": "^0.12.7",
    "heic-convert": "^2.1.0",
    "openai": "^6.9.1",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/heic-convert": "^2.1.0",
    "@types/node": "^25.9.1",
    "esbuild": "^0.27.2",
    "tsx": "^4.21.0"
  }
}
